            "_of": "correct use of the lifeline retrieval system"
          }
        },
        {
          "id": "written-check",
          "kind": "choice",
          "competency": "KNW",
          "weight": 1,
          "params": {
            "required": [
              "q1_a",
              "q2_c",
              "q3_b",
              "q4_b",
              "q5_a",
              "q6_a"
            ]
          }
        }
      ]
    }
