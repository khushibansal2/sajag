<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools">

    <!-- The worker flavour needs a camera; the verifier flavour does not, and
         asking for one it never uses is a permission prompt a gate guard will
         refuse. required=false plus a runtime check keeps one manifest. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.ar" android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- The courier relay: sealed bundles move phone-to-phone underground with
         no cellular signal at all. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES"
                     android:usesPermissionFlags="neverForLocation"
                     tools:targetApi="33" />

    <!-- Android 11+ hides other apps unless declared. Without this the phone's
         text-to-speech engine is invisible and every spoken instruction is silent. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <!-- usesCleartextTraffic: the demo issuer runs on a laptop over plain HTTP
         on the site LAN. Remove before pilot and put the issuer behind TLS. -->
    <application
        android:name=".SajagApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Theme.Sajag"
        android:allowBackup="false"
        android:usesCleartextTraffic="true"
        android:supportsRtl="true">

        <!-- OPTIONAL, not required. Marked "optional", the app installs on a
             phone with no ARCore support and its drills use the camera view
             instead. Marked "required", the Play listing hides the app from
             every worker the problem statement is actually about. -->
        <meta-data android:name="com.google.ar.core" android:value="optional" />

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|locale|layoutDirection|uiMode|fontScale|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
