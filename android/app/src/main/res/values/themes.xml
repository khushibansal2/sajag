<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The app draws edge to edge (MainActivity.enableEdgeToEdge) and sets the
         bar icon colours per screen; these are only the values before Compose
         takes over. -->
    <style name="Theme.Sajag" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
